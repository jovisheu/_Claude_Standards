{
  "AES256Key": "__AES256_KEY__",
  "AES256IV": "__AES256_IV__",
  "ConnectionStrings": {
    "DefaultConnection": "__ENC_CONNECTION_STRING__"
  },
  "Jwt": {
    "Issuer": "__PROJECT_NAME__",
    "Audience": "__PROJECT_NAME__",
    "Key": "__ENC_JWT_KEY__",
    "ExpireMinutes": 60
  },
  "Security": {
    "Login": {
      "MaxFailedAttempts": 5,
      "FailedWindowMinutes": 15,
      "LockoutMinutes": 15,
      "RateLimitPerMinute": 10,
      "CaptchaEnabled": true,
      "CaptchaLength": 5,
      "CaptchaExpireMinutes": 5,
      "CaptchaRateLimitPerMinute": 30
    },
    "Password": {
      "MinLength": 8,
      "RequiredCategories": 3,
      "HistoryCount": 3,
      "ExpireDays": 180,
      "ChangeTokenExpireMinutes": 10
    },
    "PasswordReset": {
      "TokenExpireMinutes": 30,
      "RequestIntervalMinutes": 5
    }
  },
  "App": {
    "SystemName": "__PROJECT_NAME__",
    "FrontendUrl": "__FRONTEND_URL__"
  },
  "Smtp": {
    "Enabled": __SMTP_ENABLED__,
    "Host": "__SMTP_HOST__",
    "Port": __SMTP_PORT__,
    "UseSsl": __SMTP_USE_SSL__,
    "SenderName": "__SMTP_SENDER_NAME__",
    "SenderEmail": "__SMTP_SENDER_EMAIL__",
    "Username": "__SMTP_USERNAME__",
    "Password": "__ENC_SMTP_PASSWORD__",
    "PickupDirectory": "MailPickup"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
